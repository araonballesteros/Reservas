<odoo>
    <record id="view_sala_reunion_tree" model="ir.ui.view">
        <field name="name">sala.reunion.tree</field>
        <field name="model">sala.reunion</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="capacidad"/>
                <field name="ubicacion"/>
                <field name="disponible"/>
            </list>
        </field>
    </record>

    <record id="view_sala_reunion_form" model="ir.ui.view">
        <field name="name">sala.reunion.form</field>
        <field name="model">sala.reunion</field>
        <field name="arch" type="xml">
            <form string="Sala de Reunión">
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="capacidad"/>
                        <field name="ubicacion"/>
                        <field name="disponible"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
